# ==============================================================================
# SIH26155 GenAI Content Transformation Platform — Environment Configuration
# NOTE: This file documents all available configuration variables.
# Copy this file to .env and adjust values for your local or deployment environment.
# DO NOT COMMIT SENSITIVE PRODUCTION CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# --- Application Core Settings ---
PROJECT_NAME="GenAI Content Transformation Platform"
ENVIRONMENT=development                # Options: development, staging, production, test
DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-secure-32-character-random-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80
LOG_LEVEL=INFO

# --- Air-Gap & Security Constraints ---
# Strict air-gap enforcement blocks any third-party telemetry, CDN, or cloud API calls
AIRGAP_STRICT_MODE=true
# Key for AES-256 at-rest document and artifact encryption (32-byte hex string)
STORAGE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
UPLOAD_STORAGE_PATH=/data/encrypted_uploads

# --- PostgreSQL (Metadata, Ingestion Store & Append-Only Audit Log) ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=genai_platform
POSTGRES_USER=genai_user
POSTGRES_PASSWORD=genai_secure_pass
# Internal SQLAlchemy database URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://genai_user:genai_secure_pass@postgres:5432/genai_platform

# --- Qdrant (Vector Store for Grounding & Chunk Embeddings) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_DEFAULT=source_chunks
QDRANT_API_KEY=

# --- FalkorDB (Graph Store for Entity-Relationship Grounding) ---
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_GRAPH_DEFAULT=genai_knowledge_graph

# --- Local AI Models Configuration (Air-Gapped / Offline Weights) ---
MODELS_DIR=/models
REASONING_MODEL_NAME=Qwen3-8B
VISION_MODEL_NAME=Qwen3-VL-4B
ASR_MODEL_NAME=Whisper-medium.en
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# --- Frontend Client Settings ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
REACT_APP_API_BASE_URL=http://localhost:8000
